# 유니티 프로젝트용 .gitignore (GitHub 의 Unity 템플릿 + 이 프로젝트에 맞게 조금)
# Library·Temp·Logs 등은 유니티가 열 때 다시 만드는 캐시라 올리지 않음
# (Library/PackageCache 의 burst dylib 처럼 100MB 넘는 파일도 여기에 있음)

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# 에셋 스토어 도구가 만드는 것
/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio·Rider 캐시
.vs/
.idea/
.gradle/
ExportedObj/
.consulo/

# 유니티가 자동으로 만드는 솔루션·프로젝트 파일
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# 디버그 심볼 .meta
*.pidb.meta
*.pdb.meta
*.mdb.meta

# 크래시 리포트
sysinfo.txt
crashlytics-build.properties

# 빌드 결과물
*.apk
*.aab
*.app

# Addressables 기본 빌드 폴더
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# 빌드 트리거(빌더가 읽고 바로 지우는 임시 파일)
/[Aa]ssets/PNU_Drive/Editor/run_*.txt
/[Aa]ssets/PNU_Drive/Editor/run_*.txt.meta
/[Aa]ssets/PNU_RoadGen/Editor/run_*.txt
/[Aa]ssets/PNU_RoadGen/Editor/run_*.txt.meta
